#include <bits/stdc++.h>
 
using namespace std;
 
#define endl '\n' 
#define int long long
 
void solve () {
    int x, n; cin >> x >> n;
    vector<int> v;

    for(int i = 0; i < n; i++){
        int num; cin >> num;
        v.push_back(num);
    }

    set<int> s;
    s.insert(0);
    s.insert(x);

    int maximo = -1;

    for(int i = 0; i < n; i++){
        auto ind = s.lower_bound(v[i]);
        int r = s.at(ind), l = s.at(ind - 1);

        maximo = max(max(v[i] - l, r - v[i]), maximo);

        cout << maximo << " ";
    }

    cout << endl;
}

signed main() {
    ios_base::sync_with_stdio(0);cin.tie(0);
    int TC = 0;
    if (TC){
        cin >> TC;
        while (TC--) solve();
    } else {
        solve();
    }
    return 0;
}